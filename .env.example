# Copy this file to .env.local and fill in what you have.
# EVERY line is optional. With none of them set, the demo still runs end to end —
# it just says honestly on screen that the notification didn't go out.

# --- The phone buzz ------------------------------------------------------

# A real text message. About a penny each, ~$10 per thousand people.
# This is the one that makes the moment land: no permission prompt, no app,
# no home-screen trick, works on every phone.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1

# Email. Free, arrives on their phone in seconds, and carries the calendar
# invite as a one-tap attachment. Set both or neither.
RESEND_API_KEY=
MAIL_FROM=The Wire <hello@yourdomain.com>

# --- Personalised copy ---------------------------------------------------

# Without this the demo uses a hand-written fallback that is already good.
# With it, every run is written around their own service and price.
# Costs roughly two cents per HUNDRED people.
ANTHROPIC_API_KEY=

# --- Your lead list ------------------------------------------------------

# A Google Apps Script web-app URL that appends a row to your sheet.
# Leads are always written to the server log too, so nothing is ever lost.
LEADS_WEBHOOK_URL=
